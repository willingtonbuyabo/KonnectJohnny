# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Client-side keys with VITE_ prefix)
# To connect your live production database, configure these variables.
# If left blank, the app will run in a rich, fully persistent LocalStorage demo mode.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SAFARICOM M-PESA DARAJA API KEYS (Mobile Money)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"

# STRIPE CREDIT CARD API KEYS (Visa, Mastercard, Apple Pay)
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
